"""Write a program to accept two numbers and a string form the user.
Perform and display arithematic opeartions(+,-,*,/,//,%,**)
on the numbers, and string operations(concationation,repetaton,slkcing, case conversion) on the strings
"""

# Accept two numbers
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

# Accept a string
s = input("Enter a string: ")

# Arithmetic operations
print("\nArithmetic Operations")
print("Addition =", a + b)
print("Subtraction =", a - b)
print("Multiplication =", a * b)
print("Division =", a / b)
print("Floor Division =", a // b)
print("Modulus =", a % b)
print("Power =", a**b)

# String operations
print("\nString Operations")
print("Concatenation =", s + s)
print("Repetition =", s * 2)
print("Slicing =", s[0:3])
print("Uppercase =", s.upper())
print("Lowercase =", s.lower())
